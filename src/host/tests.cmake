foreach(name envelope vault)
  add_executable(${name}_tests tests/${name}_tests.c)
  target_link_libraries(${name}_tests PRIVATE fv_security)
  target_compile_options(${name}_tests PRIVATE -Wall -Wextra -Werror)
  add_test(NAME ${name} COMMAND ${name}_tests)
  add_executable(${name}_pico_tests tests/${name}_tests.c)
  fv_mock_pico_hmac(${name}_pico_tests)
  target_link_libraries(${name}_pico_tests PRIVATE fv_security)
  target_compile_options(${name}_pico_tests PRIVATE -Wall -Wextra -Werror)
  add_test(NAME ${name}_pico_contract COMMAND ${name}_pico_tests)
endforeach()
